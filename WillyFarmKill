-- =========================
-- BIẾN
-- =========================

local Target=nil
local Following=false

local SavedPosition=nil
local GoingToSaved=false

-- =========================
-- LƯU VỊ TRÍ
-- =========================

Save.MouseButton1Click:Connect(function()

	local c=M.Character
	local r=c and c:FindFirstChild("HumanoidRootPart")

	if r then

		SavedPosition=r.Position

		Status.Text="✓ Đã lưu vị trí hiện tại"
		Save.Text="✓ ĐÃ LƯU"

		task.delay(1.5,function()
			if Save then
				Save.Text="📍 LƯU VỊ TRÍ"
			end
		end)

	end
end)

-- =========================
-- ĐI TỚI VỊ TRÍ
-- =========================

Go.MouseButton1Click:Connect(function()

	if SavedPosition then

		Target=nil
		Following=false
		GoingToSaved=true

		Status.Text="▶ Đang đi tới vị trí đã lưu"

	else

		Status.Text="⚠ Chưa có vị trí được lưu"

	end
end)

-- =========================
-- XÓA VỊ TRÍ
-- =========================

Clear.MouseButton1Click:Connect(function()

	SavedPosition=nil
	GoingToSaved=false

	Status.Text="Đã xóa vị trí"

	Clear.Text="✓ ĐÃ XÓA"

	task.delay(1,function()
		if Clear then
			Clear.Text="✕ XÓA VỊ TRÍ"
		end
	end)

end)

-- =========================
-- PLAYER BUTTON
-- =========================

local function AddPlayer(p)

	if p==M then return end

	local B=Instance.new("TextButton",PlayerList)

	B.Size=UDim2.new(1,-5,0,40)
	B.BackgroundColor3=Green2
	B.Text="→ "..p.Name
	B.TextColor3=Color3.new(1,1,1)
	B.TextSize=14
	B.Font=Enum.Font.GothamBold

	Instance.new("UICorner",B).CornerRadius=UDim.new(0,8)

	B.MouseButton1Click:Connect(function()

		Target=p
		Following=true
		GoingToSaved=false

		Status.Text="👤 Đang đi tới: "..p.Name

	end)
end

for _,p in ipairs(P:GetPlayers()) do
	AddPlayer(p)
end

P.PlayerAdded:Connect(AddPlayer)

PlayerLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()

	PlayerList.CanvasSize=UDim2.new(
		0,
		0,
		0,
		PlayerLayout.AbsoluteContentSize.Y+5
	)

end)

-- =========================
-- DI CHUYỂN
-- =========================

task.spawn(function()

	while task.wait(.1) do

		local c=M.Character
		local h=c and c:FindFirstChildOfClass("Humanoid")

		if h then

			if GoingToSaved and SavedPosition then

				h:MoveTo(SavedPosition)

			elseif Following and Target and Target.Parent then

				local t=Target.Character
				local r=t and t:FindFirstChild("HumanoidRootPart")

				if r then
					h:MoveTo(r.Position)
				end

			end
		end
	end

end)

-- =========================
-- PLAYER RỜI SERVER
-- =========================

P.PlayerRemoving:Connect(function(p)

	if Target==p then

		Target=nil
		Following=false

		Status.Text="Player đã rời server"

	end
end)

