-- ON/OFF
-- =========================

local on=true

Toggle.MouseButton1Click:Connect(function()

	on=not on

	F.Visible=on

	if on then

		Toggle.Text="● ON"
		Toggle.BackgroundColor3=Green

	else

		Toggle.Text="○ OFF"
		Toggle.BackgroundColor3=Color3.fromRGB(70,70,70)

		Following=false
		GoingToSaved=false

	end
end)
